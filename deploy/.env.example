# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
# docker compose --env-file deploy/.env up -d

# Required: Bearer token AgentOS must send (Authorization: Bearer <this>).
CORTEX_API_KEY=change-me-to-a-long-random-secret

# Public hostname for automatic Let's Encrypt TLS. Leave BLANK for a
# bare-IP box (Caddy then serves an internal self-signed cert the client
# must trust/pin).
CORTEX_DOMAIN=

# Model delivery — either mount a dir containing model.gguf ...
CORTEX_MODELS_DIR=./models
CORTEX_MODEL=/models/model.gguf
# ... or fetch at boot (leave CORTEX_MODELS_DIR pointing at an empty vol):
CORTEX_MODEL_URL=

# Inference config.
CORTEX_MAX_SEQ=4096
CORTEX_ENABLE_RETRIEVE=1
CORTEX_ENABLE_POLAR_CACHE=1
